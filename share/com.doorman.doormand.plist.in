<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.doorman.doormand</string>
    <key>ProgramArguments</key>
    <array>
        <string>__BIN_PATH__</string>
        <string>run</string>
        <string>--config</string>
        <string>/etc/doorman/doorman.yaml</string>
        <string>--audit</string>
        <string>/var/log/doorman/audit.log</string>
    </array>
    <key>UserName</key>
    <string>_doorman</string>
    <key>GroupName</key>
    <string>_doorman</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/doorman/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/doorman/stderr.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
